{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "status", "owner", "relationships"],
  "properties": {
    "id": { "type": "string", "pattern": "^AP-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "const": "AssuranceProfile" },
    "status": { "enum": ["proposed", "active", "retired"] },
    "owner": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 0.2 },
    "profile_version": { "const": 0.2 },
    "profile_kind": { "enum": ["general", "production-ai"] },
    "scope": { "type": "string", "minLength": 1 },
    "impact_assessments": {
      "type": "array",
      "items": { "$ref": "#/$defs/impact" }
    },
    "review_policy": { "$ref": "#/$defs/review_policy" },
    "measurement_policy": { "$ref": "#/$defs/measurement_policy" },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "retired" } },
        "required": ["status"]
      },
      "then": {
        "not": { "required": ["schema_version", "profile_version"] }
      },
      "else": {
        "not": { "required": ["profile_version"] }
      }
    }
  ],
  "$defs": {
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "type"],
      "properties": {
        "target": { "type": "string", "pattern": "^ix://" },
        "type": { "enum": ["governs", "references"] }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario", "severity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["low", "moderate", "material", "critical"] },
        "verifiability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "stochastic_dependency"],
          "properties": {
            "class": {
              "enum": ["cheap-conclusive", "probabilistic", "proxy-only"]
            },
            "stochastic_dependency": {
              "enum": ["none", "subject", "verifier", "both"]
            }
          }
        },
        "detect_before_harm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected", "control_ref"],
          "properties": {
            "expected": { "type": "boolean" },
            "control_ref": { "type": "string", "pattern": "^ix://" }
          }
        }
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "operations"],
      "properties": {
        "mode": { "enum": ["recommend", "require"] },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["spec-review", "code-review", "gap-analysis"]
          }
        }
      }
    },
    "measurement_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "stages"],
      "description": "How a measurement promotion into one of `stages` treats the independent checker's verdict (FR-025). `recommend` reports the verdict and never refuses; `require` refuses the promotion unless the checker accepted the candidate over an attested order, or a current owned exception is recorded. A stage not listed, and a profile with no measurement_policy, is `recommend`. An accepted verdict never promotes by itself: the decision owner still decides. `require` is recommended at `gate` only.",
      "properties": {
        "mode": { "enum": ["recommend", "require"] },
        "stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "observe",
              "baseline",
              "branch-comparison",
              "trend",
              "ratchet",
              "target",
              "gate"
            ]
          }
        }
      }
    }
  }
}
