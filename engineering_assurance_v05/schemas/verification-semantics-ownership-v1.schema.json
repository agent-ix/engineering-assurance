{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verification semantics ownership registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "non_executing", "concepts", "claim_strength", "result_states"],
  "properties": {
    "schema_version": {"const": "engineering-assurance.verification-semantics-ownership/v1"},
    "purpose": {"const": "semantic_ownership_registry"},
    "non_executing": {"const": true},
    "concepts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/concept"}
    },
    "claim_strength": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "authoritative_type", "cardinality", "ordering", "values"],
      "properties": {
        "authority": {"const": "engineering_assurance"},
        "authoritative_type": {"const": "engineering_assurance::claim_strength::ClaimStrength"},
        "cardinality": {"const": "exactly_one_per_advanced_result"},
        "ordering": {"const": "unordered"},
        "values": {"const": ["proven", "bounded-checked", "tested", "observed"]}
      }
    },
    "result_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    }
  },
  "definitions": {
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "authority", "authoritative_types", "link_direction", "responsibility"],
      "properties": {
        "concept": {
          "enum": ["verification_definition", "verification_execution", "check_result", "evidence", "measurement", "diagnostic", "report", "human_decision"]
        },
        "authority": {
          "enum": ["quire", "native_producer", "quoin", "originating_producer", "ix_flow"]
        },
        "authoritative_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "link_direction": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "responsibility": {"type": "string", "minLength": 1}
      }
    }
  }
}
