{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "status",
    "owner",
    "kind",
    "responsibility",
    "inputs",
    "outputs",
    "invariants",
    "failure_behaviors",
    "version_pins",
    "controls",
    "isolation",
    "replacement",
    "relationships"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^CAC-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "const": "ComponentAssuranceContract" },
    "status": { "enum": ["proposed", "active", "retired"] },
    "owner": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["deterministic", "stochastic", "human"] },
    "responsibility": { "type": "string", "minLength": 1 },
    "inputs": { "$ref": "#/$defs/non_empty_list" },
    "outputs": { "$ref": "#/$defs/non_empty_list" },
    "invariants": { "$ref": "#/$defs/non_empty_list" },
    "failure_behaviors": { "$ref": "#/$defs/non_empty_list" },
    "version_pins": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaces", "fallback", "abstention", "escalation"],
      "properties": {
        "surfaces": { "$ref": "#/$defs/non_empty_list" },
        "fallback": { "type": "string", "minLength": 1 },
        "abstention": { "type": "string", "minLength": 1 },
        "escalation": { "type": "string", "minLength": 1 }
      }
    },
    "isolation": { "type": "string", "minLength": 1 },
    "replacement": { "type": "string", "minLength": 1 },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    }
  },
  "$defs": {
    "non_empty_list": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "type"],
      "properties": {
        "target": { "type": "string", "pattern": "^ix://" },
        "type": { "enum": ["references"] }
      }
    }
  }
}
