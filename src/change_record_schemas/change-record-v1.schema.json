{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "status", "criteria", "spec_criteria", "reviews", "approvals", "test_results", "private_form", "failures"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "status": {"enum": ["passed", "failed"]},
    "ticket": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": {"kind": {"const": "linear_issue"}, "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9]{1,9}$"}}
    },
    "criteria": {"type": "array", "items": {"type": "string", "pattern": "^AC-[0-9]{1,3}$"}},
    "spec_criteria": {"type": "array", "items": {"type": "string", "pattern": "^(FR|NFR)-[0-9]+-AC-[0-9]+$"}},
    "reviews": {
      "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "verdict", "artifact_digest"],
        "properties": {"kind": {"enum": ["spec_review", "code_review", "rust_review", "gap_analysis"]}, "verdict": {"enum": ["pass", "findings", "fail"]}, "artifact_digest": {"$ref": "#/$defs/digest"}}}
    },
    "approvals": {
      "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["role", "verdict"],
        "properties": {"role": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "verdict": {"enum": ["covered", "missing"]}, "statement_digest": {"$ref": "#/$defs/digest"}},
        "allOf": [{"if": {"properties": {"verdict": {"const": "covered"}}}, "then": {"required": ["statement_digest"]}}, {"if": {"properties": {"verdict": {"const": "missing"}}}, "then": {"not": {"required": ["statement_digest"]}}}]}
    },
    "test_results": {"$ref": "#/$defs/digest"},
    "agent_bom": {"$ref": "#/$defs/digest"},
    "private_form": {"$ref": "#/$defs/digest"},
    "failures": {"type": "array", "items": {"enum": ["gate_failed", "approvals_incomplete", "approval_role_unstaffed", "approvals_unavailable", "contract_missing", "reviews_missing", "leak_check_refused"]}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}, "then": {"properties": {"failures": {"maxItems": 0}}}},
    {"if": {"required": ["agent_bom"]}, "then": {}, "else": {"properties": {"status": {"const": "failed"}, "failures": {"contains": {"const": "contract_missing"}}}}},
    {"if": {"properties": {"ticket": {"type": "object"}}, "required": ["ticket"]}, "then": {}, "else": {"properties": {"failures": {"contains": {"const": "contract_missing"}}}}}
  ],
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
