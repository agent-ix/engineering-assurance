{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/engineering-assurance/producer-execution-request-v1.schema.json",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "engineering-assurance.producer-execution-request/v1"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "caller": {
      "$ref": "#/$defs/contract"
    },
    "procedure": {
      "const": "direct"
    },
    "capabilityRoot": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "literal"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "input_artifact"
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "role"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "output_artifact"
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "role"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "environment": {
      "type": "object",
      "maxProperties": 512,
      "additionalProperties": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "const": true
          }
        },
        "required": [
          "role",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "stdin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "null"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "input_artifact"
            },
            "role": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "role"
          ],
          "additionalProperties": false
        }
      ]
    },
    "outputs": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "path",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "outputTrees": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "path",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "containment": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "process-group-v1"
        },
        "contract": {
          "$ref": "#/$defs/contract"
        }
      },
      "required": [
        "profile",
        "contract"
      ],
      "additionalProperties": false
    },
    "cancellation": {
      "$ref": "#/$defs/cancellation"
    },
    "budget": {
      "type": "object",
      "properties": {
        "timeoutMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "maxStdoutBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "maxStderrBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "maxInputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "maxOutputArtifacts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "maxDescendants": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "timeoutMillis",
        "maxStdoutBytes",
        "maxStderrBytes",
        "maxInputBytes",
        "maxOutputArtifacts",
        "maxOutputBytes",
        "maxDescendants",
        "maxConcurrency"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "protocol": {
          "$ref": "#/$defs/contract"
        },
        "adapter": {
          "$ref": "#/$defs/contract"
        },
        "exitCodes": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "any"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "exact"
                },
                "codes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer"
                  }
                }
              },
              "required": [
                "kind",
                "codes"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "protocol",
        "adapter",
        "exitCodes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol",
    "producer",
    "caller",
    "procedure",
    "capabilityRoot",
    "arguments",
    "environment",
    "inputs",
    "stdin",
    "outputs",
    "containment",
    "cancellation",
    "budget",
    "response"
  ],
  "additionalProperties": false,
  "title": "engineering-assurance.producer-execution-request/v1",
  "description": "JSON Schema (draft 2020-12). Closed request for `engineering-assurance producer-execute --request`. Unknown fields are refused. The CLI additionally enforces the structural rules of FR-019 (absolute paths, unique roles, declared roles) that a schema cannot express.",
  "$defs": {
    "contract": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "version"
      ],
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "executable"
      ],
      "additionalProperties": false
    },
    "cancellation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "disabled"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "event"
            },
            "authority": {
              "type": "string",
              "minLength": 1
            },
            "event_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "authority",
            "event_id"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
