{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:agent-ix:engineering-assurance:approval-gate-request:v1",
  "title": "Engineering Assurance approval gate request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "current_head", "policy", "reviews", "account_types"],
  "properties": {
    "protocol": {
      "const": "engineering-assurance.review-gate-request/v1"
    },
    "current_head": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "description": "Validated against approval-policy/v1 by the review-gate command."
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/review"
      }
    },
    "account_types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account", "account_type"],
        "properties": {
          "account": {
            "$ref": "#/definitions/account"
          },
          "account_type": {
            "$ref": "#/definitions/account_type"
          }
        }
      }
    },
    "source_unavailable": {
      "type": "boolean"
    }
  },
  "definitions": {
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "account_type": {
      "enum": ["human", "bot_or_app", "unknown", "unavailable"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id", "account", "account_type", "state", "submitted_body",
        "body_edited", "submitted_at", "commit", "pull_request"
      ],
      "properties": {
        "review_id": {"type": "integer", "minimum": 0},
        "account": {"$ref": "#/definitions/account"},
        "account_type": {"$ref": "#/definitions/account_type"},
        "state": {
          "enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED", "DISMISSED", "COMMENTED"]
        },
        "submitted_body": {"type": "string"},
        "body_edited": {"type": "boolean"},
        "submitted_at": {"type": "string", "format": "date-time"},
        "commit": {"type": "string", "minLength": 1},
        "pull_request": {"type": "string", "minLength": 1}
      }
    }
  }
}
