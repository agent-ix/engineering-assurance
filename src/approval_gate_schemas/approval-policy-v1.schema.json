{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:agent-ix:engineering-assurance:approval-policy:v1",
  "title": "Engineering Assurance approval policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "required_roles", "individuals", "roles"],
  "properties": {
    "protocol": {
      "const": "engineering-assurance.approval-policy/v1"
    },
    "required_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "individuals": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/definitions/name"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/definitions/account"
        }
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/name"
      },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "$ref": "#/definitions/name"
        }
      }
    },
    "agents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/account"
      },
      "default": []
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
