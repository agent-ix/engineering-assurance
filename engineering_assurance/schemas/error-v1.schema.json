{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Engineering Assurance machine error v1",
  "description": "A bounded fail-closed machine error emitted only after a complete value is buffered.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "capability", "code", "message"],
  "properties": {
    "protocol": {"const": "engineering-assurance.error/v1"},
    "capability": {"type": "string", "minLength": 1},
    "code": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1}
  }
}
