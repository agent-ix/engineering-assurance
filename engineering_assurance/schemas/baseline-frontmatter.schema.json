{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/engineering-assurance-campaign/baseline-frontmatter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "name",
    "items"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^BL-[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "Baseline"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human name of the baseline. The baseline is identified by the git commit it is read at, never by this file."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Configuration items, each identified by its repository path. No digest or listing of content is recorded: the commit fixes every byte.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?:[^/.*?\\[\\]{}\\\\][^/*?\\[\\]{}\\\\]*|\\.[^/.*?\\[\\]{}\\\\][^/*?\\[\\]{}\\\\]*|\\.\\.[^/*?\\[\\]{}\\\\]+)(?:/(?:[^/.*?\\[\\]{}\\\\][^/*?\\[\\]{}\\\\]*|\\.[^/.*?\\[\\]{}\\\\][^/*?\\[\\]{}\\\\]*|\\.\\.[^/*?\\[\\]{}\\\\]+))*$",
            "description": "Repository-relative file path: no leading slash, no `..` or `.` segment, no empty segment and no glob character."
          },
          "kind": {
            "enum": [
              "spec_artifact",
              "soup_record",
              "evidence"
            ]
          }
        }
      }
    }
  }
}
