{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Read-only PGM-01 compatibility view v1",
  "description": "A mapping result over immutable legacy bytes; not a rewritten evidence record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mapping_version", "source_schema_version", "source_record_id", "source_digest", "outcome", "mappings", "unmapped_fields", "limitations"],
  "properties": {
    "mapping_version": {"const": "engineering-assurance.pgm01-compatibility-view/v1"},
    "source_schema_version": {"type": "string", "minLength": 1},
    "source_record_id": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "outcome": {"enum": ["compatible", "lossy", "incompatible", "unreadable"]},
    "mappings": {"type": "array", "items": {"$ref": "#/definitions/mapping"}},
    "unmapped_fields": {"type": "array", "items": {"$ref": "#/definitions/unmapped"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "definitions": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "target_concept", "target_field", "value"],
      "properties": {
        "source_path": {"type": "string", "pattern": "^/"},
        "target_concept": {"enum": ["verification_definition", "verification_execution", "check_result", "evidence", "measurement", "diagnostic", "report", "human_decision"]},
        "target_field": {"type": "string", "minLength": 1},
        "value": {}
      }
    },
    "unmapped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "reason"],
      "properties": {
        "source_path": {"type": "string", "pattern": "^/"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
