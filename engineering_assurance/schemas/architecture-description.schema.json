{
  "$defs": {
    "relationship": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "pattern": "^ix://",
          "type": "string"
        },
        "type": {
          "enum": [
            "realizes",
            "references"
          ]
        }
      },
      "required": [
        "target",
        "type"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.agent-ix.org/agent-ix/engineering-assurance-campaign/0.5.0/architecture-description.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^AD-[0-9]+$",
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/relationship"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "superseded",
        "retired"
      ]
    },
    "system": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "ArchitectureDescription"
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "status",
    "owner",
    "system",
    "relationships"
  ],
  "type": "object"
}
