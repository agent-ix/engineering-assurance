{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Engineering Assurance language boundary result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "repository", "base_revision", "head_revision", "outcome", "findings"],
  "properties": {
    "protocol": {"const": "engineering-assurance.language-boundary/v1"},
    "repository": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "head_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "outcome": {"enum": ["accepted", "refused"]},
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "evidence"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["executable-file", "foreign-source", "action-container", "templated-npm-manifest", "opaque-submodule", "rust-wrapper-launch", "dynamic-rust-launch", "inline-launch", "indirect-launch", "npm-bin", "npm-script", "npm-dependency"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "accepted"}}}, "then": {"properties": {"findings": {"maxItems": 0}}}},
    {"if": {"properties": {"outcome": {"const": "refused"}}}, "then": {"properties": {"findings": {"minItems": 1}}}}
  ]
}
