{
  "$defs": {
    "non_empty_list": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "relationship": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "pattern": "^ix://",
          "type": "string"
        },
        "type": {
          "enum": [
            "references"
          ]
        }
      },
      "required": [
        "target",
        "type"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.agent-ix.org/agent-ix/engineering-assurance-campaign/0.5.0/component-assurance-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "controls": {
      "additionalProperties": false,
      "properties": {
        "abstention": {
          "minLength": 1,
          "type": "string"
        },
        "escalation": {
          "minLength": 1,
          "type": "string"
        },
        "fallback": {
          "minLength": 1,
          "type": "string"
        },
        "surfaces": {
          "$ref": "#/$defs/non_empty_list"
        }
      },
      "required": [
        "surfaces",
        "fallback",
        "abstention",
        "escalation"
      ],
      "type": "object"
    },
    "failure_behaviors": {
      "$ref": "#/$defs/non_empty_list"
    },
    "id": {
      "pattern": "^CAC-[0-9]+$",
      "type": "string"
    },
    "inputs": {
      "$ref": "#/$defs/non_empty_list"
    },
    "invariants": {
      "$ref": "#/$defs/non_empty_list"
    },
    "isolation": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "enum": [
        "deterministic",
        "stochastic",
        "human"
      ]
    },
    "outputs": {
      "$ref": "#/$defs/non_empty_list"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/relationship"
      },
      "type": "array"
    },
    "replacement": {
      "minLength": 1,
      "type": "string"
    },
    "responsibility": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "retired"
      ]
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "ComponentAssuranceContract"
    },
    "version_pins": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "status",
    "owner",
    "kind",
    "responsibility",
    "inputs",
    "outputs",
    "invariants",
    "failure_behaviors",
    "version_pins",
    "controls",
    "isolation",
    "replacement",
    "relationships"
  ],
  "type": "object"
}
