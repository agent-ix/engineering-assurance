{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/engineering-assurance-campaign/0.5.0/assurance-argument-frontmatter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "status",
    "owner",
    "profile",
    "top_claim",
    "reasoning",
    "assumptions",
    "participants",
    "challenges",
    "relationships"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^AA-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "const": "AssuranceArgument" },
    "status": { "enum": ["proposed", "active", "retired"] },
    "owner": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "pattern": "^ix://" },
    "top_claim": { "$ref": "#/$defs/claim" },
    "reasoning": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reasoning" }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumption" }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/participant" }
    },
    "challenges": {
      "type": "array",
      "items": { "$ref": "#/$defs/challenge" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "subject", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "supported", "challenged", "rejected"] },
        "evidence_refs": {
          "description": "ix:// references to the authoritative evidence records the claim cites. Required and non-empty when status is supported: a claim is never declared supported without referencing the evidence that supports it. A citation alone is not support; the sufficiency decision remains the authorized participant's.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ix://" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "supported" } }
          },
          "then": { "required": ["evidence_refs"] }
        }
      ]
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "supports", "sufficiency_criteria"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "supports": { "type": "string", "minLength": 1 },
        "sufficiency_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "owner", "status", "review_by"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "confirmed", "invalid"] },
        "review_by": { "type": "string", "format": "date-time", "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:(?:0[048]|[2468][048]|[13579][26])00|[0-9]{2}(?:0[48]|[2468][048]|[13579][26]))-02-29)[Tt ](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$" }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "authority", "independence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "independence": { "type": "string", "minLength": 1 }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "statement", "status", "owner"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved", "accepted"] },
        "owner": { "type": "string", "minLength": 1 },
        "resolution_ref": { "type": "string", "pattern": "^ix://" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "type"],
      "properties": {
        "target": { "type": "string", "pattern": "^ix://" },
        "type": { "enum": ["supports", "references"] }
      }
    }
  }
}
