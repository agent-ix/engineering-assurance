{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "status",
    "owner",
    "profile",
    "top_claim",
    "reasoning",
    "assumptions",
    "participants",
    "challenges",
    "relationships"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^AA-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "const": "AssuranceArgument" },
    "status": { "enum": ["proposed", "active", "retired"] },
    "owner": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "pattern": "^ix://" },
    "top_claim": { "$ref": "#/$defs/claim" },
    "reasoning": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reasoning" }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumption" }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/participant" }
    },
    "challenges": {
      "type": "array",
      "items": { "$ref": "#/$defs/challenge" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "subject", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "supported", "challenged", "rejected"] }
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "supports", "sufficiency_criteria"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "supports": { "type": "string", "minLength": 1 },
        "sufficiency_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "owner", "status", "review_by"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "confirmed", "invalid"] },
        "review_by": { "type": "string", "format": "date-time" }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "authority", "independence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "independence": { "type": "string", "minLength": 1 }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "statement", "status", "owner"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved", "accepted"] },
        "owner": { "type": "string", "minLength": 1 },
        "resolution_ref": { "type": "string", "pattern": "^ix://" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "type"],
      "properties": {
        "target": { "type": "string", "pattern": "^ix://" },
        "type": { "enum": ["supports", "references"] }
      }
    }
  }
}
