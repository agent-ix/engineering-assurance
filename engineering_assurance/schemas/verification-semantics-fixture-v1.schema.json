{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verification semantics interoperability fixture v1",
  "description": "Exact source-version premises and non-persisted semantic references for local compatibility validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_version", "source_version_premises", "references"],
  "properties": {
    "fixture_version": {"const": "engineering-assurance.verification-semantics-fixture/v1"},
    "source_version_premises": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/premise"}
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  },
  "definitions": {
    "premise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "schema_identity", "schema_version"],
      "properties": {
        "concept": {
          "enum": ["verification_definition", "verification_execution", "check_result", "evidence", "measurement", "diagnostic", "report", "human_decision"]
        },
        "schema_identity": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
