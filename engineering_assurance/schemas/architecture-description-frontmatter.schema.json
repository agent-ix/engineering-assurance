{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/engineering-assurance-campaign/0.5.0/architecture-description-frontmatter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "status", "owner", "system", "relationships"],
  "properties": {
    "id": { "type": "string", "pattern": "^AD-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "const": "ArchitectureDescription" },
    "status": { "enum": ["proposed", "accepted", "superseded", "retired"] },
    "owner": { "type": "string", "minLength": 1 },
    "system": { "type": "string", "minLength": 1 },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    }
  },
  "$defs": {
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "type"],
      "properties": {
        "target": { "type": "string", "pattern": "^ix://" },
        "type": { "enum": ["realizes", "references"] }
      }
    }
  }
}
