{
  "$defs": {
    "impact": {
      "additionalProperties": false,
      "properties": {
        "detect_before_harm": {
          "additionalProperties": false,
          "properties": {
            "control_ref": {
              "pattern": "^ix://",
              "type": "string"
            },
            "expected": {
              "type": "boolean"
            }
          },
          "required": [
            "expected",
            "control_ref"
          ],
          "type": "object"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "scenario": {
          "minLength": 1,
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "moderate",
            "material",
            "critical"
          ]
        },
        "verifiability": {
          "additionalProperties": false,
          "properties": {
            "class": {
              "enum": [
                "cheap-conclusive",
                "probabilistic",
                "proxy-only"
              ]
            },
            "stochastic_dependency": {
              "enum": [
                "none",
                "subject",
                "verifier",
                "both"
              ]
            }
          },
          "required": [
            "class",
            "stochastic_dependency"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "scenario",
        "severity"
      ],
      "type": "object"
    },
    "measurement_policy": {
      "additionalProperties": false,
      "description": "How a measurement promotion into one of `stages` treats the independent checker's verdict (FR-025). `recommend` reports the verdict and never refuses; `require` refuses the promotion unless the checker accepted the candidate over an attested order, or a current owned exception is recorded. A stage not listed, and a profile with no measurement_policy, is `recommend`. An accepted verdict never promotes by itself: the decision owner still decides. `require` is recommended at `gate` only.",
      "properties": {
        "mode": {
          "enum": [
            "recommend",
            "require"
          ]
        },
        "stages": {
          "items": {
            "enum": [
              "observe",
              "baseline",
              "branch-comparison",
              "trend",
              "ratchet",
              "target",
              "gate"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "mode",
        "stages"
      ],
      "type": "object"
    },
    "relationship": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "pattern": "^ix://",
          "type": "string"
        },
        "type": {
          "enum": [
            "governs",
            "references"
          ]
        }
      },
      "required": [
        "target",
        "type"
      ],
      "type": "object"
    },
    "review_policy": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "recommend",
            "require"
          ]
        },
        "operations": {
          "items": {
            "enum": [
              "spec-review",
              "code-review",
              "gap-analysis"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "mode",
        "operations"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.agent-ix.org/agent-ix/engineering-assurance-campaign/0.5.0/assurance-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "not": {
          "required": [
            "profile_version"
          ]
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "retired"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "schema_version",
            "profile_version"
          ]
        }
      }
    }
  ],
  "properties": {
    "id": {
      "pattern": "^AP-[0-9]+$",
      "type": "string"
    },
    "impact_assessments": {
      "items": {
        "$ref": "#/$defs/impact"
      },
      "type": "array"
    },
    "measurement_policy": {
      "$ref": "#/$defs/measurement_policy"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "profile_kind": {
      "enum": [
        "general",
        "production-ai"
      ]
    },
    "profile_version": {
      "const": 0.2
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/relationship"
      },
      "type": "array"
    },
    "review_policy": {
      "$ref": "#/$defs/review_policy"
    },
    "schema_version": {
      "const": 0.2
    },
    "scope": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "retired"
      ]
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "AssuranceProfile"
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "status",
    "owner",
    "relationships"
  ],
  "type": "object"
}
